{
  "name": "LenderAppetite",
  "type": "object",
  "properties": {
    "lender_id": { "type": "string", "description": "Linked lender profile" },
    "product_family": { "type": "string", "description": "Product family" },
    "product_type": { "type": "string", "description": "Product type" },
    "sub_product": { "type": "string", "description": "Sub-product" },
    "status": { "type": "string", "enum": ["active", "paused", "withdrawn"], "default": "active", "description": "Appetite status" },
    "minimum_loan": { "type": "number", "description": "Minimum loan" },
    "maximum_loan": { "type": "number", "description": "Maximum loan" },
    "minimum_term": { "type": "integer", "description": "Minimum term in months" },
    "maximum_term": { "type": "integer", "description": "Maximum term in months" },
    "max_ltv": { "type": "number", "description": "Maximum LTV percentage" },
    "max_lt_gdv": { "type": "number", "description": "Maximum LT-GDV percentage" },
    "max_loan_to_cost": { "type": "number", "description": "Maximum loan-to-cost percentage" },
    "security_types_accepted": { "type": "array", "description": "Accepted security types" },
    "charge_types_accepted": { "type": "array", "description": "Accepted charge types" },
    "regions_accepted": { "type": "array", "description": "Accepted regions" },
    "regulated_allowed": { "type": "boolean", "default": false, "description": "Regulated cases allowed" },
    "third_party_charge_allowed": { "type": "boolean", "default": false, "description": "Third-party charges allowed" },
    "indicative_rate_minimum": { "type": "number", "description": "Indicative minimum rate" },
    "indicative_rate_maximum": { "type": "number", "description": "Indicative maximum rate" },
    "specific_rate": { "type": "number", "description": "Specific rate where applicable" },
    "rate_period": { "type": "string", "description": "Rate period" },
    "arrangement_fee": { "type": "number", "description": "Arrangement fee percentage" },
    "exit_fee": { "type": "number", "description": "Exit fee percentage" },
    "broker_proc_fee": { "type": "number", "description": "Broker or procuration fee percentage" },
    "bespoke_pricing_notes": { "type": "string", "description": "Bespoke pricing notes" },
    "last_updated": { "type": "string", "format": "date", "description": "Last updated date" },
    "source": { "type": "string", "description": "Source of appetite record" },
    "confidence_level": { "type": "string", "enum": ["low", "medium", "high"], "default": "medium", "description": "Confidence in appetite data" }
  },
  "required": ["lender_id", "product_type", "status", "source", "confidence_level"]
}
