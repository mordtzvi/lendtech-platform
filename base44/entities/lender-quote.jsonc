{
  "name": "LenderQuote",
  "type": "object",
  "properties": {
    "case_id": { "type": "string", "description": "Linked case ID" },
    "lender_id": { "type": "string", "description": "Linked lender ID" },
    "lender_name": { "type": "string", "description": "Lender name snapshot" },
    "quote_type": { "type": "string", "enum": ["Indicative terms", "Credit-backed terms", "Formal offer", "Revised offer"], "description": "Quote type" },
    "quote_status": { "type": "string", "enum": ["Awaited", "Received", "AI extracted", "Broker review required", "Broker approved", "Sent to client", "Client viewed", "Client queried", "Client selected", "Revised terms requested", "Proceeding", "Declined by client", "Expired", "Superseded"], "description": "Quote status" },
    "loan_amount": { "type": "number", "description": "Loan amount" },
    "cmv_property_value": { "type": "number", "description": "CMV or property value" },
    "ltv_ltcmv": { "type": "number", "description": "LTV or LT-CMV percentage" },
    "refinance_amount": { "type": "number", "description": "Refinance amount" },
    "capital_raise": { "type": "number", "description": "Capital raise" },
    "arrangement_fee_percentage": { "type": "number", "description": "Arrangement fee percentage" },
    "arrangement_fee_amount": { "type": "number", "description": "Arrangement fee amount" },
    "paid_to_uka_lendtech_broker": { "type": "number", "description": "Paid to UKA, LendTech or broker" },
    "interest_rate": { "type": "number", "description": "Interest rate" },
    "annual_interest_cost": { "type": "number", "description": "Annual interest cost" },
    "monthly_interest_cost": { "type": "number", "description": "Monthly interest cost" },
    "term_duration": { "type": "string", "description": "Term or duration" },
    "repayment_type": { "type": "string", "description": "Repayment type" },
    "personal_guarantee_percentage": { "type": "number", "description": "Personal guarantee percentage" },
    "personal_guarantee_amount": { "type": "number", "description": "Personal guarantee amount" },
    "breakage_costs": { "type": "string", "description": "Breakage costs" },
    "icr": { "type": "string", "description": "ICR" },
    "dscr": { "type": "string", "description": "DSCR" },
    "conditions": { "type": "string", "description": "Conditions" },
    "notes": { "type": "string", "description": "Notes" },
    "pros": { "type": "array", "description": "Broker-approved or suggested pros" },
    "cons": { "type": "array", "description": "Broker-approved or suggested cons" },
    "source": { "type": "string", "description": "Quote source" }
  },
  "required": ["case_id", "lender_name", "quote_type", "quote_status"]
}
